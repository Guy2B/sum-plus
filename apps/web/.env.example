# Copy to .env.local (development) or .env.production (build) and fill in.
# Everything here ends up in the public bundle: NEVER put a secret in this file.

# --- Firebase web app (public identifiers) ----------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=project-sum-b961a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-sum-b961a
VITE_FIREBASE_STORAGE_BUCKET=project-sum-b961a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=669651136797
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=europe-west1
# reCAPTCHA Enterprise site key used by Firebase App Check (recommended in production)
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Use the local Firebase emulator suite (auth, firestore, functions)
VITE_USE_EMULATORS=false

# --- OAuth public client IDs ------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client (Web)
VITE_GOOGLE_CLIENT_ID=
# Microsoft Entra > App registrations > Application (client) ID (SPA platform)
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT=common

# --- Social connectors (require the matching Cloud Functions secrets) ------
VITE_SOCIAL_LINKEDIN_ENABLED=false
VITE_SOCIAL_X_ENABLED=false
VITE_SOCIAL_TIKTOK_ENABLED=false
VITE_SOCIAL_META_ENABLED=false

# --- Payments (Lemon Squeezy hosted checkout) -------------------------------
VITE_PAYMENT_MODE=test
VITE_CHECKOUT_MONTHLY_URL=
VITE_CHECKOUT_ANNUAL_URL=
VITE_PRICE_MONTHLY=8,90 €
VITE_PRICE_ANNUAL=69 €

# --- Legal identity (required before commercial launch) ---------------------
VITE_LEGAL_ENTITY=
VITE_LEGAL_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_PUBLIC_URL=

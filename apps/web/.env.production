# Public web configuration for the free (Spark) backend "sum-plus-app".
# These values are NOT secrets: Firebase web config ships in every client bundle.
# Access is protected by Firebase Auth + firestore.rules, not by hiding these keys.
VITE_FIREBASE_API_KEY=AIzaSyAv0WeHoHqQSBdWbq5C3DlhPbvcVzg3VXI
VITE_FIREBASE_AUTH_DOMAIN=sum-plus-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sum-plus-app
VITE_FIREBASE_STORAGE_BUCKET=sum-plus-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=282619101068
VITE_FIREBASE_APP_ID=1:282619101068:web:6383eb69e6542fa18160a9

# Free mode: no Cloud Functions (Blaze plan) deployed yet.
VITE_FUNCTIONS_ENABLED=false
# Launch mode: every feature unlocked until payments go live
# (keep in sync with openAccess() in firestore.rules; release-check blocks it).
VITE_OPEN_ACCESS=true

# Google connectors (Gmail, Agenda, YouTube, Drive) — public OAuth client ID,
# browser-only token flow (no secret). Origins allowed: guy2b.github.io, sum-plus-app.web.app.
VITE_GOOGLE_CLIENT_ID=282619101068-1g25sc204ktq64jr3hquqm16nvnu4pme.apps.googleusercontent.com

# Connector API (IMAP, LinkedIn, X, TikTok) on Netlify Functions — free tier.
VITE_FUNCTIONS_URL=https://sum-plus-api.netlify.app/api

# Social connectors served by the Netlify API (client secrets live only there).
VITE_SOCIAL_LINKEDIN_ENABLED=true
VITE_SOCIAL_TIKTOK_ENABLED=true

# Legal identity (Impressum, privacy policy, terms, support).
VITE_LEGAL_ENTITY=ALGBr, Inhaber: Guy Beaho
VITE_LEGAL_ADDRESS=Carlo-Mierendorff-Str. 15, 68623 Lampertheim, Deutschland

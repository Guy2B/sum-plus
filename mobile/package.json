{
  "name": "@sigma/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Σ Life OS Android / iOS shells (Capacitor).",
  "scripts": {
    "build:web": "npm run build --prefix ../apps/web",
    "prepare:web": "node scripts/prepare-web.mjs",
    "assets": "node scripts/make-assets.mjs && npx capacitor-assets generate --android --assetPath assets",
    "sync": "npm run build:web && npm run prepare:web && npx cap sync android",
    "health:patch": "node scripts/install-native.mjs",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}

rules_version = '2';

// Σ Life OS — Firestore security rules.
//
// Principles
// - Deny by default; every readable/writable path is listed explicitly.
// - A user only ever touches documents under users/{their uid}.
// - Cloud sync is a Pro feature: writes require a server-issued entitlement.
// - Health records additionally require the user's recorded consent.
// - Entitlements, connector credentials, OAuth states, rate limits and the
//   audit log are written by Cloud Functions only (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function entitlement(uid) {
      return get(/databases/$(database)/documents/entitlements/$(uid)).data;
    }

    // Launch mode: cloud sync open to every signed-in user until payments go live.
    // Set to false once the Lemon Squeezy webhook (Cloud Functions, Blaze plan) is deployed.
    function openAccess() {
      return true; // OPEN_ACCESS
    }

    function canSync(uid) {
      return openAccess() || isPro(uid);
    }

    function isPro(uid) {
      let e = entitlement(uid);
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && e.plan == 'pro'
        && (e.status in ['active', 'on_trial', 'past_due']
            || (e.status == 'cancelled' && e.validUntilTs != null && e.validUntilTs > request.time));
    }

    function healthConsented(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/meta/settings;
      return exists(path) && get(path).data.consent.health != null;
    }

    // Collections the client may sync. Provider caches (mailMessages,
    // socialItems) and the coach transcript are local-only by design.
    function syncable(col) {
      return col in [
        'tasks', 'projects', 'finance', 'health', 'journal', 'skills', 'events',
        'habits', 'habitLogs', 'goals', 'contacts', 'mailAccounts', 'socialAccounts',
        'household', 'schoolItems', 'applications', 'checkins', 'feedback', 'missions'
      ];
    }

    function validRecord(docId) {
      let d = request.resource.data;
      return d.id == docId
        && docId.size() > 0 && docId.size() <= 128
        && d.createdAt is string && d.updatedAt is string
        && d.updatedAt.size() <= 40
        && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is string)
        && d.serverUpdatedAt == request.time
        && d.keys().size() <= 60;
    }

    match /users/{uid} {
      // The parent document itself is never written by clients.
      allow read: if isOwner(uid);

      match /meta/settings {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && canSync(uid)
          && request.resource.data.serverUpdatedAt == request.time
          && request.resource.data.keys().size() <= 40;
        allow delete: if isOwner(uid);
      }

      match /{col}/{docId} {
        allow read: if isOwner(uid) && syncable(col);
        allow create, update: if isOwner(uid) && syncable(col) && canSync(uid)
          && validRecord(docId)
          && (col != 'health' || healthConsented(uid));
        // Deletions replicate as tombstones (deletedAt); hard deletes happen only when the
        // owner erases their account.
        allow delete: if isOwner(uid) && syncable(col);
      }
    }

    // Opt-in, anonymous product measurement: counters only — no uid, no content.
    // Anyone may add one well-formed event; only admins can read them; nobody edits.
    function smallInt(d, k) {
      return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= 10000);
    }
    function shortStr(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /telemetry/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['e', 'day', 'cohort', 'age', 'ed', 'lang', 'v', 'src', 'ai', 'pf', 'expireAt',
                                                              'p', 'a', 's', 'c', 'd', 'r', 'w', 'ov', 'ob', 'lr', 'eb', 'ea', 'from', 'ans'])
        && request.resource.data.keys().hasAll(['e', 'day', 'cohort', 'age', 'expireAt'])
        && request.resource.data.e in ['app_open', 'onboarding_started', 'onboarding_complete', 'first_plan', 'first_decision',
                                       'first_completed', 'decision_started', 'decision_completed', 'coach_used',
                                       'coach_plan_applied', 'day_replanned', 'daily_summary', 'pro_gate_seen',
                                       'pro_cta_clicked', 'checkout_started', 'price_interest']
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.cohort is string && request.resource.data.cohort.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.age is int && request.resource.data.age >= 0 && request.resource.data.age <= 90
        && shortStr(request.resource.data, 'ed', 16) && shortStr(request.resource.data, 'v', 16)
        && (!('lang' in request.resource.data) || request.resource.data.lang in ['fr', 'en', 'de', 'es'])
        && (!('src' in request.resource.data) || request.resource.data.src in ['demo', 'mine', 'direct'])
        && (!('ai' in request.resource.data) || request.resource.data.ai in ['core', 'browser', 'local'])
        && (!('pf' in request.resource.data) || request.resource.data.pf in ['web', 'pwa', 'app'])
        && (!('from' in request.resource.data)
            || request.resource.data.from in ['sidebar', 'account', 'coach', 'projects', 'habits', 'feature'])
        && (!('ans' in request.resource.data) || request.resource.data.ans in ['yes', 'maybe', 'expensive', 'useless'])
        && smallInt(request.resource.data, 'p') && smallInt(request.resource.data, 'a') && smallInt(request.resource.data, 's')
        && smallInt(request.resource.data, 'c') && smallInt(request.resource.data, 'd') && smallInt(request.resource.data, 'r')
        && smallInt(request.resource.data, 'w') && smallInt(request.resource.data, 'ov') && smallInt(request.resource.data, 'ob')
        && smallInt(request.resource.data, 'lr') && smallInt(request.resource.data, 'eb') && smallInt(request.resource.data, 'ea')
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(400, 'd');
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Weekly pulse answers: only what the person chose to type and send.
    match /testimonials/{answerId} {
      allow create: if request.resource.data.keys().hasOnly(['vote', 'text', 'sig', 'publish', 'day', 'lang', 'ed', 'age', 'expireAt'])
        && request.resource.data.vote in ['up', 'down']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.sig is string && request.resource.data.sig.size() <= 60
        && request.resource.data.publish is bool
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.lang in ['fr', 'en', 'de', 'es']
        && shortStr(request.resource.data, 'ed', 16)
        && request.resource.data.age is int && request.resource.data.age >= 0 && request.resource.data.age <= 3650
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(740, 'd');
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Founder programme (beta): days a signed-in account used Σ. One day at a time.
    match /founders/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['activeDays', 'firstSeen', 'lastSeen', 'updatedAt'])
        && request.resource.data.activeDays == 1
        && request.resource.data.firstSeen is string && request.resource.data.firstSeen.size() == 10
        && request.resource.data.lastSeen == request.resource.data.firstSeen
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['activeDays', 'firstSeen', 'lastSeen', 'updatedAt'])
        && request.resource.data.activeDays == resource.data.activeDays + 1
        && request.resource.data.firstSeen == resource.data.firstSeen
        && request.resource.data.lastSeen is string && request.resource.data.lastSeen.size() == 10
        && request.resource.data.lastSeen > resource.data.lastSeen
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // Aggregates written by the Netlify job (Admin SDK); read by admins only.
    match /analytics_daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /analytics_cohorts/{cohort} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /private/{document=**} {
      allow read, write: if false;
    }

    match /oauthStates/{document=**} {
      allow read, write: if false;
    }

    match /rateLimits/{document=**} {
      allow read, write: if false;
    }

    match /auditLog/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
